{
  "contract_version": 1,
  "description": "Referenzfälle für den additiven, partiellen Import des gemeinsamen Austauschformats.",
  "duplicate_identity": [
    "date",
    "type",
    "start",
    "end",
    "comment"
  ],
  "cases": [
    {
      "id": "add-new-entry",
      "existing_entries": [],
      "incoming_entries": [
        {
          "date": "2098-07-15",
          "type": "home",
          "start": "08:00",
          "end": "16:30",
          "comment": "JSON-Test",
          "glz_override": null,
          "glz_override_source": null
        }
      ],
      "expected": {
        "imported_entries": 1,
        "skipped_entries": 0
      }
    },
    {
      "id": "skip-identical-entry",
      "existing_entries": [
        {
          "date": "2098-07-15",
          "type": "home",
          "start": "08:00",
          "end": "16:30",
          "comment": "JSON-Test",
          "glz_override": null,
          "glz_override_source": null
        }
      ],
      "incoming_entries": [
        {
          "date": "2098-07-15",
          "type": "home",
          "start": "08:00",
          "end": "16:30",
          "comment": "JSON-Test",
          "glz_override": null,
          "glz_override_source": null
        }
      ],
      "expected": {
        "imported_entries": 0,
        "skipped_entries": 1
      }
    },
    {
      "id": "skip-invalid-neighbours-with-detail-codes",
      "existing_entries": [],
      "incoming_entries": [
        {
          "date": "2098-02-30",
          "type": "home",
          "start": "",
          "end": ""
        },
        {
          "date": "2098-02-28",
          "type": "home",
          "start": "8:00",
          "end": "16:00"
        },
        {
          "date": "2098-02-28",
          "type": "home",
          "start": "08:00",
          "end": "16:00",
          "glz_override": "Infinity"
        },
        {
          "date": "2098-02-28",
          "type": "home",
          "start": "08:00",
          "end": "16:00",
          "glz_override_source": "unknown"
        },
        {
          "date": "2098-02-28",
          "type": "home",
          "start": "08:00",
          "end": "16:00",
          "glz_override": 3,
          "glz_override_source": "manual"
        }
      ],
      "expected": {
        "imported_entries": 1,
        "skipped_entries": 0,
        "invalid_entries": 4,
        "details": [
          "entries[0]: invalid_date",
          "entries[1]: invalid_time",
          "entries[2]: invalid_glz_override",
          "entries[3]: invalid_glz_override_source"
        ]
      }
    }
  ]
}
