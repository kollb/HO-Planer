{
  "contract_version": 1,
  "description": "Referenzszenarien für GLZ-Fortschreibung und Anker. Die konkreten Salden ergeben sich aus den Vertragsregeln für Sollzeit und Tagesnettozeit.",
  "cases": [
    {
      "id": "pdf-anchor-starts-follow-up-calculation",
      "entries": [
        {"date": "2025-01-02", "type": "home", "start": "08:00", "end": "16:30", "glz_override": 12.5, "glz_override_source": "pdf"},
        {"date": "2025-01-03", "type": "office", "start": "08:00", "end": "16:30", "glz_override": null, "glz_override_source": null}
      ],
      "expected_anchor": {"date": "2025-01-02", "value": 12.5, "source": "pdf"}
    },
    {
      "id": "manual-anchor-is-preserved-in-portable-format",
      "entries": [
        {"date": "2025-02-03", "type": "home", "start": "08:00", "end": "16:30", "glz_override": -3.25, "glz_override_source": "manual"}
      ],
      "expected_anchor": {"date": "2025-02-03", "value": -3.25, "source": "manual"}
    },
    {
      "id": "multiple-anchors-on-same-day-use-last-stored-entry",
      "entries": [
        {"date": "2025-03-03", "type": "home", "start": "08:00", "end": "16:30", "glz_override": 1.5, "glz_override_source": "manual"},
        {"date": "2025-03-03", "type": "office", "start": "08:00", "end": "16:30", "glz_override": 4.0, "glz_override_source": "pdf"}
      ],
      "expected_anchor": {"date": "2025-03-03", "value": 4.0, "source": "pdf"}
    },
    {
      "id": "no-anchor-starts-at-first-entry-in-target-year",
      "entries": [
        {"date": "2025-05-03", "type": "home", "start": "08:00", "end": "16:30"}
      ],
      "target": {"year": 2025, "month": 6},
      "expected_first_calculation_date": "2025-05-03"
    },
    {
      "id": "no-anchor-and-no-entry-is-zero",
      "entries": [],
      "expected_carryover": 0.0
    }
  ]
}
